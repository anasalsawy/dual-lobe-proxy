# Upstream provider config (Deep Infra)
DUAL_LOBE_A_MODEL=Qwen/Qwen3-Max
DUAL_LOBE_A_BASE_URL=https://api.deepinfra.com/v1/openai
DUAL_LOBE_A_API_KEY=your_deepinfra_key

DUAL_LOBE_B_MODEL=Qwen/Qwen3-Max
DUAL_LOBE_B_BASE_URL=https://api.deepinfra.com/v1/openai
DUAL_LOBE_B_API_KEY=your_deepinfra_key

# Database (Railway Postgres)
RLS_DATABASE_URL=${{Postgres.DATABASE_URL}}

# Routing
DUAL_LOBE_ROUTING_MODE=off
DUAL_LOBE_HIERARCHY_ROLES=chief:0,l1:1,l2:2,worker:3

# Optional toggles
DUAL_LOBE_IMPLEMENTATION_AUDIT_ENABLED=true
DUAL_LOBE_CONTEXT_MEMORY_ENABLED=true
DUAL_LOBE_CLAIM_CHECKS_ENABLED=true
DUAL_LOBE_DECEPTION_METER_ENABLED=true
