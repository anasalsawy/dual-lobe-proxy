POSTGRES_DB=${{POSTGRES_DB}}
POSTGRES_PORT=${{PGPORT}}
DATABASE_URL=${{DATABASE_URL}}
RLS_DATABASE_URL=${{RLS_DATABASE_URL}}

# Proxy Configuration
DUAL_LOBE_PORT=${{PORT}}
DUAL_LOBE_BOOTSTRAP_KEYS=${{DUAL_LOBE_BOOTSTRAP_KEYS}}

# Model Configuration (using DeepInfra)
DUAL_LOBE_A_MODEL=Qwen/Qwen3-Max
DUAL_LOBE_A_BASE_URL=https://api.deepinfra.com/v1/openai
DUAL_LOBE_A_API_KEY=${{DEEPINFRA_API_KEY}}
DUAL_LOBE_A_DIALECT=chat_completions

# Enable Lobe B (Observer/Router) - can use same or different model
DUAL_LOBE_B_ENABLED=true
DUAL_LOBE_B_MODEL=Qwen/Qwen3-Max
DUAL_LOBE_B_BASE_URL=https://api.deepinfra.com/v1/openai
DUAL_LOBE_B_API_KEY=${{DEEPINFRA_API_KEY}}

# Memory and Context
DUAL_LOBE_SHARED_MEMORY_ENABLED=true
DUAL_LOBE_DEFAULT_MEMORY_ID=main
DUAL_LOBE_CONTEXT_MEMORY_ENABLED=true
DUAL_LOBE_CLAIM_CHECKS_ENABLED=true

# Director Mode (for autonomous agents)
DUAL_LOBE_DIRECTOR_ENABLED=true

# Hierarchy Roles Configuration (Human Sovereign rules)
DUAL_LOBE_HIERARCHY_ROLES=sawii/dl-dialogue1:0,sawii/dl-dialogue2:1,sawii/dl-dialogue3:2

# Performance
DUAL_LOBE_LOG_LEVEL=INFO
