# Local development. Do not expose this Compose stack publicly.
POSTGRES_USER=dual_lobe
POSTGRES_PASSWORD=dual_lobe_dev
POSTGRES_DB=dual_lobe
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dual_lobe:dual_lobe_dev@localhost:5432/dual_lobe
# Required for native gateway startup; never falls back to the owner connection.
RLS_DATABASE_URL=postgresql+asyncpg://dual_lobe_rls:dual_lobe_rls@localhost:5432/dual_lobe

DUAL_LOBE_PORT=8801
# REQUIRED: generate a secret (e.g. openssl rand -hex 32) and replace this placeholder.
# Format: secret|comma-separated-scopes|tenant; separate multiple entries with ;
DUAL_LOBE_BOOTSTRAP_KEYS=REPLACE_WITH_A_RANDOM_SECRET|inference:invoke,events:write,state:read|default

# Configure actual model IDs offered by your OpenAI-compatible providers.
DUAL_LOBE_A_MODEL=your-worker-model
DUAL_LOBE_A_BASE_URL=https://api.featherless.ai/v1
DUAL_LOBE_A_API_KEY=
DUAL_LOBE_A_DIALECT=chat_completions
# Omit B model/base/key to inherit A; preferably use a separate B quota/provider.
# Do not set B_API_KEY to an empty string when intending inheritance.
# DUAL_LOBE_B_MODEL=your-observer-model
# DUAL_LOBE_B_BASE_URL=https://your-provider.example/v1
# DUAL_LOBE_B_API_KEY=your-key

DUAL_LOBE_B_ENABLED=true
DUAL_LOBE_OBSERVATION_REMINDER=true
# Fixed instruction role; use developer only if your provider supports that role.
DUAL_LOBE_MONITORING_ROLE=system
# Independent routes: broadening memory vs claim findings supplied in the request.
DUAL_LOBE_CONTEXT_MEMORY_ENABLED=true
DUAL_LOBE_CLAIM_CHECKS_ENABLED=true
DUAL_LOBE_CONTEXT_MEMORY_TTL_SECONDS=86400
DUAL_LOBE_MAX_MEMORY_CHARS=1600
# context = auto-load memory + direct claim findings; observation = reminder only.
# Legacy integrity/enforcement names are advisory aliases, NEVER blocking modes.
DUAL_LOBE_ROLLOUT_STAGE=context
# Observe each call; rapid/backlogged work can be skipped/coalesced by the worker.
DUAL_LOBE_PULSE_EVERY=1
DUAL_LOBE_B_COOLDOWN_SECONDS=0
# Claim findings expire sooner than broader context memory.
DUAL_LOBE_B_STATE_TTL_SECONDS=180
# Best-effort cached-state read: at most 25ms + cancellation cleanup, no B model wait.
DUAL_LOBE_B_STATE_READ_TIMEOUT=0.025
DUAL_LOBE_MAX_INJECTION_CHARS=1200
DUAL_LOBE_MAX_SHADOW_INPUT_CHARS=18000
DUAL_LOBE_B_MAX_OUTPUT_TOKENS=1400
DUAL_LOBE_B_TIMEOUT=20
# Per-tenant, per-worker-process call budget, not a monetary/global quota.
DUAL_LOBE_B_RPM_LIMIT=20
DUAL_LOBE_WORKER_MAX_CONCURRENCY=2
DUAL_LOBE_WORKER_POLL_SECONDS=1
DUAL_LOBE_WORKER_LOCK_SECONDS=90

# A attempts (1 = no retry); never replay a partially delivered stream.
DUAL_LOBE_A_RETRIES=1
DUAL_LOBE_A_TIMEOUT=180
# Gateway admission limits are process-local; TPM is a rough input estimate.
DUAL_LOBE_RPM_LIMIT=600
DUAL_LOBE_TPM_LIMIT=120000
DUAL_LOBE_MAX_REQUEST_BYTES=4194304
DUAL_LOBE_LOG_LEVEL=INFO
DUAL_LOBE_OTEL_ENABLED=false
